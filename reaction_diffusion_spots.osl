// 09_reaction_diffusion_spots.osl
//
// 반응-확산(Reaction-Diffusion, 튜링 패턴) 시뮬레이션이 만들어내는 표범 무늬나
// 얼룩말 줄무늬 같은 결과물을 흉내내는 셰이더입니다.
//
// [중요한 한계]
// 실제 반응-확산 패턴은 두 화학 물질(활성체/억제체)의 농도가 시간에 따라
// 서로의 확산 속도 차이로 상호작용하며 격자 전체에서 반복적으로 갱신되는
// 시뮬레이션(예: Gray-Scott 모델)의 결과입니다. OSL 셰이더는 각 지점을 독립적으로,
// 단 한 번에 계산하기 때문에 이런 반복 갱신 과정을 그대로 계산할 수는 없습니다.
// 대신 여기서는 서로 다른 두 주파수의 노이즈를 빼는 방식(Difference of Gaussian과
// 유사한 개념)으로, 반응-확산 결과물과 시각적으로 비슷한 반점 경계를 절차적으로
// 만들어냅니다.
//
// [필요 노드]
// 1. Texture Coordinate 노드의 Generated 출력을 Script 노드의 Position 소켓에 연결
// 2. Script 노드의 Color 출력을 Emission/Principled BSDF에 연결

shader reaction_diffusion_spots(
    point Position = P,
    float Scale = 8.0,
    float SpotScaleRatio = 2.4,   // 두 노이즈 주파수의 비율. 값이 클수록 반점이 작고 촘촘해짐
    float EdgeSoftness = 0.05,    // 값이 작을수록 반점 경계가 날카로워져 대비가 강해짐
    color ColorSpot = color(1.0, 0.85, 0.0),
    color ColorBase = color(0.05, 0.05, 0.08),
    output color Color = color(0.0, 0.0, 0.0)
)
{
    point p = Position * Scale;

    // 서로 다른 두 주파수의 노이즈를 샘플링합니다.
    // n1은 큰 형태(반점의 대략적인 배치), n2는 그보다 촘촘한 주파수로,
    // 반응-확산에서 활성체/억제체가 서로 다른 확산 속도를 갖는 것과 비슷한 역할을 합니다.
    float n1 = snoise(p);
    float n2 = snoise(p * SpotScaleRatio + point(5.2, 1.3, 0.0));

    // 두 노이즈의 차이를 구하면, 두 패턴이 어긋나는 경계를 따라 반점 형태의
    // 등고선이 만들어집니다.
    float diff = n1 - n2 * 0.5;

    // 임계값(0) 근처를 EdgeSoftness 폭으로만 부드럽게 통과시켜 또렷한 반점 경계를 만듭니다.
    float mask = smoothstep(-EdgeSoftness, EdgeSoftness, diff);

    Color = mix(ColorBase, ColorSpot, mask);
}
