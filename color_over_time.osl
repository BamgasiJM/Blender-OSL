// color_over_time.osl
//
// 가장 기본적인 형태: Time 입력값 하나로 색상을 순환시킴.
// Script 노드 -> Emission 노드의 Color, 또는 Principled BSDF의 Base Color에 연결.
// Time은 그냥 float 파라미터로, 셰이더 자체는 애니메이션 로직을 모르고 외부에서 넣어주는
// 값을 그대로 씀. Time에 Value 노드를 연결해서 #frame/30 등 드라이브 표현식을 입력.

shader color_over_time(
    float Time = 0.0,
    float Speed = 1.0,
    output color Color = color(0.0, 0.0, 0.0)
)
{
    float t = Time * Speed;

    // sin 파형을 R/G/B 채널마다 120도씩 위상차를 줘서 색상환을 순환시킴
    Color = color(
        0.5 + 0.5 * sin(t),
        0.5 + 0.5 * sin(t + 2.0944),  // +120°
        0.5 + 0.5 * sin(t + 4.18879)  // +240°
    );
}