// 07_metaball_blobs.osl
//
// 메타볼(Metaball): 여러 개의 중심점에서 거리 제곱에 반비례하는 "장(field)" 값을
// 방출시키고, 그 값들을 모두 합산한 뒤 특정 임계값(threshold)을 넘는 영역을
// 채워 그리는 기법입니다. 서로 가까워진 두 개 이상의 볼이 부드럽게 이어지며
// 하나의 유기적인 형태로 합쳐지는 것이 메타볼의 핵심 특징입니다.
//
// [필요 노드]
// 1. Texture Coordinate 노드의 Generated 출력을 Script 노드의 Position 소켓에 연결
// 2. Value 노드에 #frame/30 을 입력해 드라이버를 건 뒤 Script 노드의 Time 소켓에
//    연결하면 볼들이 서로 궤도를 그리며 움직여 합쳐졌다 떨어지는 애니메이션이 됩니다
// 3. Script 노드의 Color 출력을 Emission 노드에 연결 (Rim 발광 효과가
//    1.0을 넘어가도록 설계되어 있어, Emission Strength를 올리면 블룸과 잘 어울립니다)

// 중심점(center)으로부터의 거리 제곱에 반비례하는 값을 반환합니다.
// 분모에 작은 값(0.0004)을 더해 중심점 정확히 위에서 값이 무한대로 발산하는 것을 방지합니다.
float metaball_field(point p, point center, float weight)
{
    float dx = p[0] - center[0];
    float dy = p[1] - center[1];
    float d2 = dx * dx + dy * dy;
    return weight / (d2 + 0.0004);
}

shader metaball_blobs(
    point Position = P,
    float Time = 0.0,
    float Speed = 1.0,
    float Threshold = 1.0,
    float Softness = 0.15,
    float RimIntensity = 2.0,
    color ColorInside = color(1.0, 0.1, 0.55),
    color ColorRim = color(1.0, 0.9, 0.2),
    color ColorOutside = color(0.02, 0.02, 0.06),
    output color Color = color(0.0, 0.0, 0.0),
    output float Field = 0.0
)
{
    // Generated 좌표(0~1)를 -0.5~0.5 범위로 중심 이동시킵니다.
    point p = point(Position[0] - 0.5, Position[1] - 0.5, 0.0);
    float t = Time * Speed;

    // 5개의 메타볼 중심을 각기 다른 반지름/속도/위상으로 궤도 운동시켜
    // 유기적으로 움직이는 배치를 만듭니다. 값을 직접 바꿔가며 실험해볼 수 있습니다.
    point c1 = point(0.28 * sin(t * 1.0),        0.28 * cos(t * 1.3),        0.0);
    point c2 = point(0.28 * sin(t * 1.7 + 2.1),  0.28 * cos(t * 0.9 + 2.1),  0.0);
    point c3 = point(0.22 * sin(t * 0.6 + 4.2),  0.22 * cos(t * 2.1 + 4.2),  0.0);
    point c4 = point(0.32 * cos(t * 1.4 + 1.0),  0.32 * sin(t * 0.8 + 1.0),  0.0);
    point c5 = point(0.18 * cos(t * 2.3 + 3.0),  0.18 * sin(t * 1.6 + 3.0),  0.0);

    float field = 0.0;
    field += metaball_field(p, c1, 0.018);
    field += metaball_field(p, c2, 0.018);
    field += metaball_field(p, c3, 0.018);
    field += metaball_field(p, c4, 0.018);
    field += metaball_field(p, c5, 0.018);
    Field = field;

    // 임계값을 부드럽게 통과시켜 안/밖을 가르는 마스크를 만듭니다.
    float inside = smoothstep(Threshold - Softness, Threshold + Softness, field);

    // field 값이 Threshold에 정확히 가까운 위치일수록 밝아지는 테두리(rim) 발광을
    // exp() 감쇠 함수로 만듭니다. 메타볼 경계를 따라 빛나는 윤곽선을 만드는 트릭입니다.
    float rim = exp(-abs(field - Threshold) * 12.0) * RimIntensity;

    Color = mix(ColorOutside, ColorInside, inside) + ColorRim * rim;
}
