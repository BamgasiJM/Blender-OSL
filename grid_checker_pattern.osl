// 02_grid_checker_pattern.osl
//
// 표면의 UV 좌표를 격자로 나누고, 각 셀마다 해시(hash) 함수로 고유한 랜덤 값을
// 부여하는 기법입니다. 체커보드, 픽셀 아트, 몬드리안 스타일 모자이크 등
// 격자 기반 제너레이티브 아트의 기초가 됩니다.
//
// [필요 노드]
// 이 셰이더는 u, v (표면 파라메트릭 좌표)를 OSL 내장 전역 변수로 직접 사용하므로
// 별도의 노드 연결이 필요 없습니다. Script 노드를 배치하고 Color 출력만
// Emission/Principled BSDF에 연결하면 바로 동작합니다.
// (오브젝트에 UV 맵이 없으면 u,v는 렌더러가 자동 생성한 기본 매핑을 사용합니다)

// 0~1 사이의 의사 난수를 만드는 해시 함수입니다.
// OSL에는 GLSL의 fract() 같은 함수가 없어서, x - floor(x)로 소수 부분만
// 직접 잘라내는 방식으로 구현합니다. sin()의 큰 계수를 곱해 값을 뒤섞는 것은
// 셰이더 아트에서 흔히 쓰이는 "가짜 난수(pseudo-random)" 트릭입니다.
float hash21(float x, float y)
{
    float n = sin(x * 127.1 + y * 311.7) * 43758.5453123;
    return n - floor(n);
}

shader grid_checker_pattern(
    int GridSize = 8,
    color ColorA = color(0.9, 0.9, 0.9),
    color ColorB = color(0.05, 0.05, 0.05),
    int RandomizeCells = 0,   // 0 = 체크보드 패턴, 1 = 셀마다 랜덤 밝기
    output color Color = color(0.0, 0.0, 0.0)
)
{
    // u, v(0~1)를 GridSize 배수로 확대한 뒤 floor()로 정수 셀 인덱스를 구합니다.
    float cellU = floor(u * GridSize);
    float cellV = floor(v * GridSize);

    if (RandomizeCells == 1) {
        // 셀 인덱스를 해시 함수에 넣어 셀마다 다른 밝기를 랜덤하게 부여합니다.
        float r = hash21(cellU, cellV);
        Color = mix(ColorB, ColorA, r);
    } else {
        // 체크보드 패턴: 셀 인덱스의 합이 짝수인지 홀수인지에 따라 색을 교대로 배치합니다.
        // fmod()로 2로 나눈 나머지를 구해 0 또는 1 값을 얻습니다.
        float checker = fmod(cellU + cellV, 2.0);
        Color = mix(ColorA, ColorB, checker);
    }
}
