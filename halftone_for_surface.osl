shader test_halftone(
    // ============================================================
    // HALFTONE
    // ============================================================
    // 하프톤 셀의 크기
    //
    // 값을 높이면:
    //     도트가 작아지고 많아집니다.
    //
    // 값을 낮추면:
    //     도트가 커지고 적어집니다.
    float Scale = 10.0,

    // 각 셀 안의 도트 크기
    //
    // 0.1 → 매우 작은 도트
    // 0.5 → 중간 크기
    // 0.9 → 큰 도트
    float DotSize = 0.55,

    // 출력
    output color Result = color(0.0)
)
{
    // ============================================================
    // 1. OBJECT SPACE POSITION
    // ============================================================
    //
    // P는 기본적으로 common(world) space 좌표입니다.
    // 오브젝트에 패턴을 고정시키려면 object space로
    // 명시적으로 변환해야 합니다.
    //
    // 변환하지 않으면 오브젝트를 이동/회전시킬 때
    // 패턴이 표면 위에서 미끄러지듯 어긋납니다.
    point Pobj = transform("object", P);

    float x = Pobj[0];
    float y = Pobj[1];

    // ============================================================
    // 2. CREATE GRID
    // ============================================================
    x *= Scale;
    y *= Scale;

    // ============================================================
    // 3. CELL COORDINATE
    // ============================================================
    float cell_x = floor(x);
    float cell_y = floor(y);

    // ============================================================
    // 4. POSITION INSIDE CELL
    // ============================================================
    float local_x = x - cell_x;
    float local_y = y - cell_y;

    // ============================================================
    // 5. MOVE ORIGIN TO CELL CENTER
    // ============================================================
    local_x -= 0.5;
    local_y -= 0.5;

    // ============================================================
    // 6. DISTANCE FROM CENTER
    // ============================================================
    //
    // 변수명을 dist로 변경했습니다.
    // OSL 내장 함수 distance(point, point)와
    // 이름이 충돌하는 것을 피하기 위해서입니다.
    float dist =
        sqrt(
            local_x * local_x +
            local_y * local_y
        );

    // ============================================================
    // 7. CREATE CIRCLE
    // ============================================================
    //
    // DotSize를 0~1 범위로 clamp합니다.
    // 범위를 벗어나는 값이 들어오면 radius가
    // 셀 반폭(0.5)을 초과하거나 음수가 되어
    // 인접 셀을 침범하는 문제가 생기기 때문입니다.
    float dot_size = clamp(DotSize, 0.0, 1.0);
    float radius = dot_size * 0.5;

    // 아주 단순한 원형 마스크입니다.
    // smoothstep을 일부러 사용하지 않습니다.
    // 먼저 "원형 도트가 정확히 생성되는가"만
    // 확인하기 위한 테스트입니다.
    float circle = 0.0;
    if (dist < radius)
    {
        circle = 1.0;
    }

    // ============================================================
    // 8. BLACK / WHITE OUTPUT
    // ============================================================
    Result = color(circle);
}