shader test_halftone(
    // ============================================================
    // HALFTONE (Screen / Raster Space)
    // ============================================================
    // 하프톤 셀 하나의 크기 (픽셀 단위)
    float CellSize = 10.000,

    // 각 셀 안의 도트 크기 (0~1)
    float DotSize = 0.300,

    // ------------------------------------------------------------
    // COLORS
    // ------------------------------------------------------------
    // 배경 색상 (도트 바깥)
    color BackgroundColor = color(0.0, 0.0, 0.0),

    // 도트 색상 (도트 안쪽)
    color DotColor = color(1.0, 1.0, 1.0),

    // ------------------------------------------------------------
    // ANIMATION
    // ------------------------------------------------------------
    // Grid 좌표에 더해지는 오프셋입니다.
    //
    // [0] = X 방향 오프셋 (cell 단위)
    // [1] = Y 방향 오프셋 (cell 단위)
    // [2] = 사용하지 않음
    //
    // 연결 방법 1 (시간에 따라 흐르는 애니메이션):
    //     Value 노드에 드라이버 #frame/30 입력
    //     → Combine XYZ 또는 Vector Math(Multiply)로
    //       원하는 방향 벡터를 곱해서 vector로 조합
    //     → 이 입력에 연결
    //     예: FlowOffset = (frame/30) * (1.0, 0.3, 0.0)
    //         → 오른쪽으로 흐르면서 살짝 위/아래로도 흐름
    //
    // 연결 방법 2 (공간 기반 왜곡, 시간과 무관):
    //     Texture Coordinate 노드(Generated, Window 등)를
    //     이 입력에 직접 연결
    //
    // 단위가 "cell 개수"이므로 FlowOffset[0] = 1.0은
    // 정확히 셀 한 칸만큼 이동한 상태를 의미합니다.
    // 너무 빠르게 흐르길 원치 않으면 Value 노드 뒤에
    // Math(Multiply) 노드로 배속을 낮추면 됩니다.
    vector FlowOffset = vector(0.0, 0.0, 0.0),

    // 출력
    output color Result = color(0.0)
)
{
    // ============================================================
    // 1. RASTER SPACE POSITION
    // ============================================================
    //
    // P를 raster space(렌더 픽셀 좌표)로 변환합니다.
    // 카메라 기준 화면 좌표이므로, 오브젝트가 움직여도
    // 패턴은 화면에 고정된 것처럼 보입니다.
    point Praster = transform("raster", P);

    float x = Praster[0];
    float y = Praster[1];

    // ============================================================
    // 2. CREATE GRID
    // ============================================================
    //
    // CellSize(픽셀)로 나눠서 셀 좌표계로 변환한 뒤
    // FlowOffset을 더해 grid 자체를 이동시킵니다.
    //
    // 나누기 전이 아니라 나눈 뒤에 더하는 이유는
    // FlowOffset의 단위를 "cell 개수"로 만들어서
    // CellSize를 바꿔도 흐르는 속도감이 유지되게 하기
    // 위해서입니다.
    x = x / CellSize + FlowOffset[0];
    y = y / CellSize + FlowOffset[1];

    // ============================================================
    // 3. CELL COORDINATE
    // ============================================================
    float cell_x = floor(x);
    float cell_y = floor(y);

    // ============================================================
    // 4. POSITION INSIDE CELL
    // ============================================================
    float local_x = x - cell_x;
    float local_y = y - cell_y;

    // ============================================================
    // 5. MOVE ORIGIN TO CELL CENTER
    // ============================================================
    local_x -= 0.5;
    local_y -= 0.5;

    // ============================================================
    // 6. DISTANCE FROM CENTER
    // ============================================================
    //
    // OSL 내장 함수 distance(point, point)와의
    // 이름 충돌을 피하기 위해 dist로 명명했습니다.
    float dist =
        sqrt(
            local_x * local_x +
            local_y * local_y
        );

    // ============================================================
    // 7. CREATE CIRCLE
    // ============================================================
    //
    // DotSize를 0~1로 clamp합니다.
    float dot_size = clamp(DotSize, 0.0, 1.0);
    float radius = dot_size * 0.5;

    float circle = 0.0;
    if (dist < radius)
    {
        circle = 1.0;
    }

    // ============================================================
    // 8. COLOR OUTPUT
    // ============================================================
    //
    // circle 마스크(0 또는 1)를 기준으로
    // BackgroundColor와 DotColor를 mix합니다.
    // OSL 표준 함수 mix(color, color, float)를 사용합니다.
    Result = mix(BackgroundColor, DotColor, circle);
}