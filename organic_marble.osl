shader organic_marble(
    color ColorA = color(0.03, 0.08, 0.12),
    color ColorB = color(0.8, 0.25, 0.05),
    color ColorC = color(0.95, 0.8, 0.35),

    float Scale = 3.0,
    float Distortion = 2.0,
    float Contrast = 2.0,

    output color Result = color(0.0)
)
{
    // ============================================================
    // 1. 좌표
    // ============================================================
    //
    // P는 현재 shading point의 Object Space 좌표입니다.
    //
    // 여기서는 World Space 좌표를 사용합니다.
    // 따라서 오브젝트를 이동하거나 회전해도
    // 패턴 자체는 World Space를 기준으로 존재합니다.
    //
    // 이것은 procedural shader에서 매우 중요한 개념입니다.
    //
    point world_P = transform("world", P);


    // ============================================================
    // 2. 첫 번째 Noise
    // ============================================================
    //
    // World Space 좌표를 noise의 입력으로 사용합니다.
    //
    // Scale을 높이면 더 작은 무늬가 만들어지고,
    // Scale을 낮추면 더 큰 무늬가 만들어집니다.

    float n1 = noise(
        "perlin",
        world_P * Scale
    );


    // ============================================================
    // 3. 두 번째 Noise
    // ============================================================
    //
    // 첫 번째 noise를 단순히 사용하는 대신
    // 좌표에 noise 값을 추가하여 좌표 자체를 왜곡합니다.
    //
    // 이것이 procedural distortion의 기본적인 형태입니다.
    //
    // 결과적으로 단순한 Perlin noise보다
    // 흐르는 듯한 유기적인 패턴을 만들 수 있습니다.

    point distorted_P = world_P;

    distorted_P += vector(
        n1 * Distortion,
        n1 * Distortion * 0.7,
        n1 * Distortion * 1.3
    );


    // ============================================================
    // 4. 왜곡된 좌표로 다시 Noise 계산
    // ============================================================
    //
    // 앞에서 만든 distorted_P를 다시 noise에 넣습니다.
    //
    // Noise → 좌표 왜곡 → Noise
    //
    // 이런 방식으로 noise를 여러 단계 조합하면
    // 단순한 노이즈보다 훨씬 복잡한 procedural pattern을
    // 만들 수 있습니다.

    float n2 = noise(
        "perlin",
        distorted_P * Scale
    );


    // ============================================================
    // 5. Sin을 이용한 흐르는 줄무늬
    // ============================================================
    //
    // noise만 사용하는 대신 sin()을 조합합니다.
    //
    // sin()의 입력에 noise를 추가하면
    // 일정한 줄무늬가 noise에 의해 휘어집니다.
    //
    // 대리석, 나무결, 유체와 같은 패턴을 만드는
    // 기본적인 방법 중 하나입니다.

    float wave = sin(
        world_P.z * Scale * 4.0
        + n2 * 8.0
    );


    // ============================================================
    // 6. -1 ~ +1 → 0 ~ 1
    // ============================================================
    //
    // sin()의 결과는 -1 ~ +1입니다.
    //
    // 색상 interpolation에 사용하기 편하도록
    // 0 ~ 1 범위로 변환합니다.

    float mask = wave * 0.5 + 0.5;


    // ============================================================
    // 7. Contrast
    // ============================================================
    //
    // mask의 대비를 조절합니다.
    //
    // 0.5를 중심으로 값을 확대합니다.
    //
    // Contrast = 1.0
    // → 원래 값
    //
    // Contrast > 1.0
    // → 밝고 어두운 영역이 더욱 분명해짐

    mask = (mask - 0.5) * Contrast + 0.5;

    // 값이 0~1 범위를 벗어나지 않도록 제한합니다.
    mask = clamp(mask, 0.0, 1.0);


    // ============================================================
    // 8. Color Mixing
    // ============================================================
    //
    // mask를 이용하여 세 가지 색상을 단계적으로 혼합합니다.
    //
    // 0.0 → ColorA
    // 0.5 → ColorB
    // 1.0 → ColorC
    //
    // smoothstep()을 사용하여 색상 경계를 부드럽게 만듭니다.

    color result_color;

    if (mask < 0.5)
    {
        float t = smoothstep(0.0, 0.5, mask);

        result_color = mix(
            ColorA,
            ColorB,
            t
        );
    }
    else
    {
        float t = smoothstep(0.5, 1.0, mask);

        result_color = mix(
            ColorB,
            ColorC,
            t
        );
    }


    // ============================================================
    // 9. Normal을 이용한 가장자리 변화
    // ============================================================
    //
    // N은 표면의 법선 방향입니다.
    //
    // 카메라 방향과 법선의 관계를 이용하면
    // 표면이 카메라를 향하는 정도를 계산할 수 있습니다.
    //
    // 여기서는 단순히 N의 Z 성분을 사용합니다.
    //
    // 결과적으로 위쪽을 향하는 표면과
    // 옆쪽을 향하는 표면의 색상이 조금 달라집니다.

    float normal_mask = N[2] * 0.5 + 0.5;


    // ============================================================
    // 10. 최종 색상
    // ============================================================
    //
    // procedural pattern과 surface normal을 결합합니다.
    //
    // 따라서 단순한 2D texture가 아니라
    // 3D 위치 + 표면 방향에 의해 결정되는 패턴입니다.

    Result = result_color * (
        0.75 + normal_mask * 0.25
    );
}