// nebula_field.osl
//
// Domain-warped fBm noise + cosine color palette ("nebula" style shader).
//
// Usage:
// 1. Shader Editor -> Add Script node -> Mode: External -> File Path
//    points to this file (relative path recommended, e.g. //shaders/nebula_field.osl).
// 2. Connect Texture Coordinate node's Generated output to the Position socket
//    (keeps the pattern stable regardless of object size).
// 3. Connect a Value node driven by scene frame (or animate manually) to the
//    Time socket for animated flow.
// 4. Scale / WarpStrength / Speed / ColorShift / Contrast / Brightness are
//    adjustable directly from the node editor.

float fbm(point p, int octaves)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    int i;
    for (i = 0; i < octaves; i += 1) {
        value += amplitude * snoise(p * frequency);
        frequency *= 2.0;
        amplitude *= 0.5;
    }
    return value;
}

color palette(float t, color a, color b, color c, color d)
{
    return a + b * cos(6.28318 * (c * t + d));
}

shader nebula_field(
    point Position = P,
    float Time = 0.0,
    float Scale = 1.6,
    float WarpStrength = 3.5,
    float Speed = 0.2,
    float ColorShift = 0.0,
    float Contrast = 1.3,
    float Brightness = 1.4,
    output closure color BSDF = emission()
)
{
    point p = Position * Scale;
    float t = Time * Speed;

    // Stage 1 warp: sample the base noise field in three directions
    point q = point(
        fbm(p + point(0.0, 0.0, t), 4),
        fbm(p + point(5.2, 1.3, t), 4),
        fbm(p + point(9.1, 4.7, t), 4)
    );

    // Stage 2 warp: distort the coordinates again using the stage 1 result
    // (this is the key step that produces the flowing, organic shapes)
    point r = point(
        fbm(p + WarpStrength * q + point(1.7, 9.2, t * 1.3), 4),
        fbm(p + WarpStrength * q + point(8.3, 2.8, t * 1.3), 4),
        fbm(p + WarpStrength * q + point(3.4, 6.1, t * 1.3), 4)
    );

    float field = fbm(p + WarpStrength * r, 5);
    field = pow(clamp(field * 0.5 + 0.5, 0.0, 1.0), Contrast);

    // Mix in the warp magnitude (length of q) for extra structure in the color
    float structure = clamp(length(q) * 0.6, 0.0, 1.0);
    float t_color = field * 0.7 + structure * 0.3 + ColorShift;

    color base = palette(
        t_color,
        color(0.5, 0.45, 0.55),
        color(0.5, 0.45, 0.5),
        color(1.0, 0.9, 0.7),
        color(0.0, 0.15, 0.3)
    );

    BSDF = (base * Brightness) * emission();
}
