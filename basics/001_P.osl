// P - 위치를 색상으로 표현

shader test_P(
    float Scale = 1.0,
    output color Result = 0
)
{
    // P는 현재 shading point의 위치를 나타내는 point 값입니다.
    // 기본적으로 오브젝트의 Object Space에서 좌표가 계산됩니다.
    //
    // 오브젝트의 중심을 기준으로 좌표를 시각화하기 위해
    // P의 각 성분을 색상으로 변환합니다.
    //
    // 일반적인 색상의 범위는 0~1이므로
    // -1~1 정도의 좌표를 0~1 범위로 이동시키기 위해
    // 0.5 + P * 0.5 형태로 변환합니다.

    point p = P * Scale;

    Result = color(
        0.5 + p.x * 0.5,
        0.5 + p.y * 0.5,
        0.5 + p.z * 0.5
    );
}