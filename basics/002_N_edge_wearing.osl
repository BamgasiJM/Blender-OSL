shader edge_wear(
    float EdgeThreshold = 0.7,
    output color Color = 0)
{
    float facing = abs(dot(N, -I));
    // 에지(0에 가까운 값)일수록 1이 되고, 정면일수록 0이 됨
    float wear_mask = 1.0 - smoothstep(0.1, EdgeThreshold, facing);
    
    // 마모된 색상(금속)과 기본 색상(페인트) 믹스
    Color = mix(color(0.11, 0.11, 0.14), color(0.9, 0.5, 0.1), wear_mask);
}