// transform() - Object Space와 World Space 비교

shader test_transform(
    float GridScale = 1.0,
    output color Result = 0
)
{
    // P는 현재 shading point의 Object Space 좌표입니다.
    point object_P = P;

    // P를 World Space로 변환합니다.
    //
    // "world"는 Blender Cycles가 제공하는
    // World 좌표계를 의미합니다.
    //
    // 오브젝트가 이동, 회전, 스케일되면
    // Object Space의 P와 World Space의 좌표가 달라집니다.
    point world_P = transform("world", P);

    // World Space 좌표를 직접 색상으로 사용하면
    // 좌표값의 범위가 0~1을 벗어날 수 있습니다.
    //
    // 따라서 fract()를 사용하여 각 좌표의
    // 소수 부분만 추출합니다.
    //
    // 이렇게 하면 World Space에 고정된
    // 반복적인 색상 패턴을 만들 수 있습니다.
    float r = fract(world_P.x * GridScale);
    float g = fract(world_P.y * GridScale);
    float b = fract(world_P.z * GridScale);

    Result = color(r, g, b);
}