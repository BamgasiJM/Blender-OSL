// UV 좌표 테스트

shader test_UV(
    output color Result = 0
)
{
    // u와 v는 현재 shading point의 UV 좌표입니다.
    //
    // 일반적인 UV 좌표는 다음과 같은 범위를 사용합니다.
    //
    // u = 0 ~ 1
    // v = 0 ~ 1
    //
    // u를 Red 채널에,
    // v를 Green 채널에 직접 연결합니다.
    //
    // 따라서 표면의 UV 좌표가 그대로 색상으로 나타납니다.
    //
    // Red가 증가하는 방향 → U 방향
    // Green이 증가하는 방향 → V 방향

    Result = color(
        u,
        v,
        0.0
    );
}