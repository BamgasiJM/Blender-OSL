// N - 표면 법선 방향을 색상으로 표현

shader test_N(
    output color Result = color(0.0)
)
{
    // N은 현재 shading point의 표면 법선(surface normal)입니다.
    //
    // 법선은 방향을 나타내는 vector이며,
    // 각 성분은 일반적으로 -1.0 ~ +1.0 범위를 가집니다.
    //
    // 예:
    //   N = ( 1, 0, 0) → +X 방향
    //   N = ( 0, 1, 0) → +Y 방향
    //   N = ( 0, 0, 1) → +Z 방향
    //
    // 하지만 RGB 색상은 0.0 ~ 1.0 범위를 사용합니다.
    // 따라서 -1.0 ~ +1.0을 0.0 ~ 1.0으로 변환합니다.
    //
    // 변환 공식:
    //
    //     color = N * 0.5 + 0.5
    //
    // 그러면
    //
    //     -1.0 → 0.0
    //      0.0 → 0.5
    //     +1.0 → 1.0

    float r = N[0] * 0.5 + 0.5;
    float g = N[1] * 0.5 + 0.5;
    float b = N[2] * 0.5 + 0.5;

    // 법선의 X 방향을 Red,
    // Y 방향을 Green,
    // Z 방향을 Blue로 표현합니다.
    Result = color(r, g, b);
}